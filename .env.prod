# ═══════════════════════════════════════════════════════════════════════════
# CloudBuilder — Production Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# Copie este arquivo para .env.prod e preencha todos os valores.
# NUNCA commite secrets no versionamento.
#
# Gere JWT_SECRET:  openssl rand -base64 64
# Gere POSTGRES_PASSWORD:  openssl rand -base64 32
# ═══════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL ──────────────────────────────────────────────────────────
POSTGRES_DB=cloudbuilder
POSTGRES_USER=cloudbuilder
POSTGRES_PASSWORD=CHANGE_ME_GERE_COM_openssl_rand_-base64_32

# ─── Backend — Spring Boot ───────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/cloudbuilder
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}
JWT_SECRET=CHANGE_ME_GERE_COM_openssl_rand_-base64_64
JWT_EXPIRATION=86400000

# ─── Application ─────────────────────────────────────────────────────────
APP_DOMAIN=cloudbuilder.example.com
