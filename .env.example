# ═══════════════════════════════════════════════════════════════
# CloudBuilder — Environment Variables Template
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloudbuilder
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=changeme

# ── Backend ──────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=changeme-at-least-32-characters-long
CLOUDBUILDER_ENCRYPTION_KEY=changeme-32-characters

# ── Frontend ─────────────────────────────────────────────────
VITE_API_URL=http://localhost:8080/api/v1
VITE_BASE_PATH=/

# ── Email (Newsletter + Transactional) ───────────────────────
VITE_PLUNK_API_KEY=pk_xxxxxxxxxxxxxxxxxxxx
PLUNK_API_KEY=pk_xxxxxxxxxxxxxxxxxxxx

# ── GitHub OAuth (SSO) ──────────────────────────────────────
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ── Google OAuth (SSO) ──────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── AI (Optional) ───────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ── Kafka (Optional) ────────────────────────────────────────
cloudbuilder.kafka.enabled=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── OPA (Policy Engine) ─────────────────────────────────────
OPA_URL=http://localhost:8181

# ── Provision Engine (Go) ───────────────────────────────────
PROVISION_ENGINE_URL=localhost:50051
