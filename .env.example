# CloudBuilder — Environment Variables
# Copy this file to .env and fill in your values
#
# Geração de secrets:
#   Linux/macOS:  openssl rand -base64 64
#   Windows:      node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"

# ─── Backend (OBRIGATORIOS) ────────────────────────────────────────────
JWT_SECRET=coloque-aqui-uma-chave-de-64-caracteres-base64
CLOUDBUILDER_ENCRYPTION_KEY=coloque-aqui-outra-chave-de-64-caracteres-base64
SPRING_PROFILES_ACTIVE=prod

# ─── PostgreSQL ────────────────────────────────────────────────────────
DB_PASSWORD=coloque-uma-senha-forte-aqui
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/cloudbuilder
SPRING_DATASOURCE_USERNAME=cloudbuilder
SPRING_DATASOURCE_PASSWORD=coloque-uma-senha-forte-aqui

# ─── Frontend ──────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8080/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── AI (Opcional) ────────────────────────────────────────────────────
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ─── SSO (Opcional) ───────────────────────────────────────────────────
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_ISSUER_URL=
