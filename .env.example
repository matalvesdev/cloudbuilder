# ⚠️ CloudBuilder — Environment Variables
# Copy this file to .env and fill in your values
#
# Geração de JWT_SECRET:
#   Linux/macOS:  openssl rand -base64 64
#   Windows:      Use: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"

# ─── Backend ───────────────────────────────────────────────────────────
JWT_SECRET=coloque-aqui-uma-chave-de-64-caracteres-base64

# ─── Frontend ──────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8080/api/v1

# ─── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_DB=cloudbuilder
POSTGRES_USER=cloudbuilder
POSTGRES_PASSWORD=coloque-uma-senha-forte-aqui

# ─── Kafka ─────────────────────────────────────────────────────────────
# Apenas necessário se usar autenticação SASL
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# ─── Redis ─────────────────────────────────────────────────────────────
# Apenas necessário se usar senha
# REDIS_PASSWORD=
