{
  "dashboard": {
    "schemaVersion": 39,
    "version": 1,
    "uid": "cloudbuilder-golden-signals",
    "title": "CloudBuilder - Four Golden Signals",
    "description": "Production observability: Latency, Traffic, Errors, Saturation.",
    "tags": [
      "cloudbuilder",
      "golden-signals",
      "production"
    ],
    "timezone": "browser",
    "editable": true,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ],
      "time_options": [
        "5m",
        "15m",
        "1h",
        "6h",
        "12h",
        "24h",
        "2d",
        "7d",
        "30d"
      ]
    },
    "panels": [
      {
        "type": "row",
        "title": "Latencia (p50/p95/p99)",
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0
        },
        "collapsed": false,
        "panels": [
          {
            "id": 1,
            "type": "timeseries",
            "title": "Latencia (p50/p95/p99)",
            "description": "Request latency percentiles. SLO: p95 < 500ms.",
            "gridPos": {
              "h": 7,
              "w": 16,
              "x": 0
            },
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "fieldConfig": {
              "defaults": {
                "unit": "s",
                "min": 0,
                "decimals": 3,
                "thresholds": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.3
                    },
                    {
                      "color": "red",
                      "value": 0.5
                    }
                  ]
                }
              },
              "overrides": []
            },
            "options": {
              "legend": {
                "calcs": [
                  "mean",
                  "max",
                  "min"
                ],
                "displayMode": "table",
                "placement": "bottom",
                "showLegend": true
              },
              "tooltip": {
                "mode": "multi"
              }
            },
            "targets": [
              {
                "expr": "histogram_quantile(0.50, rate(api_request_duration_seconds_bucket{application=\"cloudbuilder\"}[5m]))",
                "legendFormat": "p50",
                "refId": "A"
              },
              {
                "expr": "histogram_quantile(0.95, rate(api_request_duration_seconds_bucket{application=\"cloudbuilder\"}[5m]))",
                "legendFormat": "p95",
                "refId": "B"
              },
              {
                "expr": "histogram_quantile(0.99, rate(api_request_duration_seconds_bucket{application=\"cloudbuilder\"}[5m]))",
                "legendFormat": "p99",
                "refId": "C"
              }
            ]
          },
          {
            "id": 2,
            "type": "timeseries",
            "title": "SLO 99% - Budget Burn Rate",
            "description": "Error budget for 99% availability SLO.",
            "gridPos": {
              "h": 7,
              "w": 8,
              "x": 16
            },
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "fieldConfig": {
              "defaults": {
                "unit": "percentunit",
                "decimals": 4,
                "min": 0
              },
              "overrides": []
            },
            "options": {
              "legend": {
                "calcs": [
                  "mean",
                  "max",
                  "min"
                ],
                "displayMode": "table",
                "placement": "bottom",
                "showLegend": true
              },
              "tooltip": {
                "mode": "multi"
              }
            },
            "targets": [
              {
                "expr": "(1 - (sum(rate(api_requests_total{status=\"5xx\"}[30d])) / sum(rate(api_requests_total[30d]))))",
                "legendFormat": "Availability",
                "refId": "A"
              }
            ]
          }
        ]
      },
      {
        "type": "row",
        "title": "Trafego (req/s)",
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0
        },
        "collapsed": false,
        "panels": [
          {
            "id": 3,
            "type": "timeseries",
            "title": "Requisicoes por Segundo",
            "description": "Request rate by status.",
            "gridPos": {
              "h": 7,
              "w": 12,
              "x": 0
            },
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "fieldConfig": {
              "defaults": {
                "unit": "reqps",
                "min": 0,
                "decimals": 1
              },
              "overrides": []
            },
            "options": {
              "legend": {
                "calcs": [
                  "mean",
                  "max",
                  "min"
                ],
                "displayMode": "table",
                "placement": "bottom",
                "showLegend": true
              },
              "tooltip": {
                "mode": "multi"
              }
            },
            "targets": [
              {
                "expr": "sum(rate(api_requests_total{application=\"cloudbuilder\"}[5m]))",
                "legendFormat": "Total",
                "refId": "A"
              },
              {
                "expr": "sum(rate(api_requests_total{status=\"2xx\"}[5m]))",
                "legendFormat": "2xx Sucesso",
                "refId": "B"
              },
              {
                "expr": "sum(rate(api_requests_total{status=\"4xx\"}[5m]))",
                "legendFormat": "4xx Cliente",
                "refId": "C"
              },
              {
                "expr": "sum(rate(api_requests_total{status=\"5xx\"}[5m]))",
                "legendFormat": "5xx Erro",
                "refId": "D"
              }
            ]
          },
          {
            "id": 4,
            "type": "timeseries",
            "title": "Top 5 Endpoints (req/s)",
            "description": "Most requested endpoints.",
            "gridPos": {
              "h": 7,
              "w": 12,
              "x": 12
            },
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "fieldConfig": {
              "defaults": {
                "unit": "reqps",
                "min": 0,
                "decimals": 1
              },
              "overrides": []
            },
            "options": {
              "legend": {
                "calcs": [
                  "mean",
                  "max",
                  "min"
                ],
                "displayMode": "table",
                "placement": "bottom",
                "showLegend": true
              },
              "tooltip": {
                "mode": "multi"
              }
            },
            "targets": [
              {
                "expr": "topk(5, sum(rate(api_requests_total{application=\"cloudbuilder\"}[5m])) by (endpoint))",
                "legendFormat": "{{ endpoint }}",
                "refId": "A"
              }
            ]
          }
        ]
      }
    ],
    "templating": {
      "list": [
        {
          "name": "datasource",
          "type": "datasource",
          "query": "prometheus",
          "current": {
            "value": "default"
          },
          "hide": 0,
          "label": "Data Source"
        },
        {
          "name": "env",
          "type": "query",
          "query": "label_values(up{job=\"cloudbuilder-backend\"}, environment)",
          "current": {
            "value": "prod"
          },
          "hide": 2,
          "label": "Environment"
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "type": "dashboard",
          "builtIn": 0,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "enable": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "query": "changes(cloudbuilder_build_info[1m]) != 0",
          "showIn": 0
        }
      ]
    }
  }
}