# CloudBuilder Frontend - Environment Configuration
# Copy to .env.local for local development

# Backend API URL
VITE_API_URL=http://localhost:8080/api/v1

# Collaboration WebSocket URL (auto-derived from page URL if not set)
# VITE_COLLAB_WS_URL=ws://localhost:8765

# Feature flags (optional override)
# VITE_FEATURE_COST=true
# VITE_FEATURE_PLATFORM=true
# VITE_FEATURE_AIOPS=true
