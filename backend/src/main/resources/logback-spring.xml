<?xml version="1.0" encoding="UTF-8"?>
<!--
  ─── CloudBuilder — Logback Configuration ──────────────────────────────────
  Spring profile-aware:
    - dev:  human-readable console output with colors
    - prod: JSON-structured output via Logstash encoder, rolled to file

  MDC fields automatically included:
    - traceId   : distributed tracing correlation ID
    - tenantId  : multi-tenant context
    - userId    : authenticated user
    - requestId : per-request correlation ID (UUID)

  Log files stored in ./logs/ directory with daily rolling and retention.
-->
<configuration>
    <!-- Spring property access for profile detection -->
    <springProperty scope="context" name="ACTIVE_PROFILE" source="spring.profiles.active" defaultValue="dev"/>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="cloudbuilder"/>

    <!-- Console appender (used in all profiles) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%magenta(%X{traceId:-no-trace})] [%cyan(%X{tenantId:-no-tenant})] [%yellow(%X{userId:-anon})] %logger{36}.%M\(%line\) — %msg%n%ex</pattern>
        </encoder>
    </appender>

    <!-- JSON file appender (production only) -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/${APP_NAME}.json</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/${APP_NAME}.%d{yyyy-MM-dd}.%i.json.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- Include MDC fields -->
            <includeMdc>true</includeMdc>
            <!-- Exclude noisy fields -->
            <fieldNames>
                <timestamp>@timestamp</timestamp>
                <version>[ignore]</version>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
            <!-- Custom MDC field mappings -->
            <mdcKeyFieldName>traceId</mdcKeyFieldName>
            <mdcKeyFieldName>tenantId</mdcKeyFieldName>
            <mdcKeyFieldName>userId</mdcKeyFieldName>
            <mdcKeyFieldName>requestId</mdcKeyFieldName>
        </encoder>
    </appender>

    <!-- Human-readable file appender for debugging (all profiles) -->
    <appender name="TEXT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/${APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{traceId:-no-trace}] [%X{tenantId:-no-tenant}] [%X{userId:-anon}] %logger{36}.%M\(%line\) — %msg%n%ex</pattern>
        </encoder>
    </appender>

    <!-- Async appender for JSON to avoid blocking on I/O -->
    <appender name="ASYNC_JSON" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <appender-ref ref="JSON_FILE"/>
    </appender>

    <!-- ── Profile: dev ── -->
    <springProfile name="dev | default">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="TEXT_FILE"/>
        </root>
        <logger name="com.cloudbuilder" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="TEXT_FILE"/>
        </logger>
        <logger name="org.springframework.web" level="INFO"/>
        <logger name="org.hibernate.SQL" level="WARN"/>
    </springProfile>

    <!-- ── Profile: prod ── -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="ASYNC_JSON"/>
            <appender-ref ref="TEXT_FILE"/>
        </root>
        <logger name="com.cloudbuilder" level="INFO" additivity="false">
            <appender-ref ref="ASYNC_JSON"/>
            <appender-ref ref="TEXT_FILE"/>
        </logger>
        <logger name="org.springframework.web" level="WARN"/>
        <logger name="org.hibernate.SQL" level="WARN"/>
        <logger name="org.springframework.security" level="INFO"/>
    </springProfile>
</configuration>
