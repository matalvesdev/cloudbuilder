# ⚠️ CloudBuilder Backend — Environment Variables
# Copie para .env ou configure como variáveis de ambiente
# Gere JWT_SECRET: openssl rand -base64 64

CLOUDBUILDER_SECURITY_JWT_SECRET=coloque-aqui-uma-chave-de-64-caracteres-base64
CLOUDBUILDER_SECURITY_ACCESS_TOKEN_EXPIRATION=900000
CLOUDBUILDER_SECURITY_REFRESH_TOKEN_EXPIRATION=604800000

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cloudbuilder
SPRING_DATASOURCE_USERNAME=cloudbuilder
SPRING_DATASOURCE_PASSWORD=coloque-uma-senha-forte-aqui

SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_DATA_REDIS_HOST=localhost
