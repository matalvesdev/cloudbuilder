# ═══════════════════════════════════════════════════════════════════════════
# CloudBuilder — Railway Deploy (All-in-One)
# ═══════════════════════════════════════════════════════════════════════════
# Builds backend, frontend, and runs all services in one container.
# Uses supervisord to manage multiple processes.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Stage 1: Build Frontend ───────────────────────────────────────────────
FROM node:22-alpine AS frontend-build
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ .
ENV VITE_API_URL=/api/v1
RUN npm run build

# ─── Stage 2: Build Go Collab Server ───────────────────────────────────────
FROM golang:1.23-alpine AS collab-build
RUN apk add --no-cache gcc musl-dev
WORKDIR /build
COPY provision-engine/go.mod provision-engine/go.sum ./
RUN go mod download
COPY provision-engine/ .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /app/provision-engine ./cmd/provision-engine/

# ─── Stage 3: Build Backend ────────────────────────────────────────────────
FROM maven:3.9-eclipse-temurin-21-alpine AS backend-build
WORKDIR /app/backend
COPY backend/pom.xml ./
COPY backend/.mvn .mvn
RUN --mount=type=cache,target=/root/.m2 \
    mvn dependency:go-offline -q
COPY backend/src src
RUN --mount=type=cache,target=/root/.m2 \
    mvn package -DskipTests -Dmaven.test.skip=true -q

# ─── Stage 3: Extract Backend Layers ───────────────────────────────────────
FROM eclipse-temurin:21-jre-alpine AS backend-layers
WORKDIR /app/backend
COPY --from=backend-build /app/backend/target/*.jar app.jar
RUN java -Djarmode=layertools -jar app.jar extract

# ─── Stage 5: Runtime ─────────────────────────────────────────────────────
FROM eclipse-temurin:21-jre-alpine

RUN apk add --no-cache curl wget nginx supervisor

# Create non-root user
RUN addgroup -S cloudbuilder && \
    adduser -S cloudbuilder -G cloudbuilder -u 1000

WORKDIR /app

# Copy Go collab server
COPY --from=collab-build /app/provision-engine /app/provision-engine
RUN chmod +x /app/provision-engine

# Copy backend layers
COPY --from=backend-layers /app/backend/dependencies/ ./backend/
COPY --from=backend-layers /app/backend/spring-boot-loader/ ./backend/
COPY --from=backend-layers /app/backend/snapshot-dependencies/ ./backend/
COPY --from=backend-layers /app/backend/application/ ./backend/

# Copy frontend build
COPY --from=frontend-build /app/frontend/dist /usr/share/nginx/html

# Copy nginx config
COPY nginx-railway.conf /etc/nginx/nginx.conf

# Copy supervisord config
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Create logs directory
RUN mkdir -p /app/logs && chown -R cloudbuilder:cloudbuilder /app /usr/share/nginx/html /var/cache/nginx /var/log/nginx /run

EXPOSE 80 8080 8765

CMD ["supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
