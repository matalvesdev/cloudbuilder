# CloudBuilder Provision Engine — Environment Variables
# Copy to .env and fill in values

# Database
DB_PASSWORD=pe_secret

# Redis
REDIS_PASSWORD=pe_secret

# Security
JWT_SECRET=change-me-to-a-random-string

# Vault (optional)
VAULT_ADDRESS=
VAULT_TOKEN=

# Kafka (optional — default brokers in config.yaml)
# KAFKA_BROKERS=localhost:9092

# Observability (optional)
# OTEL_ENDPOINT=localhost:4317

# Version (set in CI)
VERSION=dev
