# ═══════════════════════════════════════════════════════════
# Slack Webhooks — CloudBuilder
# Copie para .env.slack e preencha com suas URLs
# ═══════════════════════════════════════════════════════════

# ── Webhook Principal (fallback) ──────────────────────────
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"

# ── Webhooks por Canal ────────────────────────────────────
# Crie um webhook para cada canal no Slack
# https://api.slack.com/apps → Incoming Webhooks → Add New Webhook

# Canal #bugs — Bugs reportados pelos testers
SLACK_BUG_WEBHOOK_URL="https://hooks.slack.com/services/BUGS/WEBHOOK/URL"

# Canal #feedback — Notas 1-5 estrelas
SLACK_FEEDBACK_WEBHOOK_URL="https://hooks.slack.com/services/FEEDBACK/WEBHOOK/URL"

# Canal #sugestoes — Ideias e melhorias
SLACK_SUGGESTIONS_WEBHOOK_URL="https://hooks.slack.com/services/SUGGESTIONS/WEBHOOK/URL"

# Canal #duvidas — Perguntas sobre uso
SLACK_QUESTIONS_WEBHOOK_URL="https://hooks.slack.com/services/QUESTIONS/WEBHOOK/URL"

# ── Discord (alternativa ao Slack) ────────────────────────
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
# DISCORD_BUG_WEBHOOK_URL="https://discord.com/api/webhooks/..."
