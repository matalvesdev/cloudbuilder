# CloudBuilder — Production Environment Variables
# ⚠️ Copy to .env.prod and fill in real values. NEVER commit .env.prod

# ─── Backend ───────────────────────────────────────────────────────────
JWT_SECRET=<generate with: openssl rand -base64 64>
CLOUDBUILDER_ENCRYPTION_KEY=<generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))">
SPRING_PROFILES_ACTIVE=prod
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ─── PostgreSQL ────────────────────────────────────────────────────────
DB_PASSWORD=<strong-random-password>
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/cloudbuilder
SPRING_DATASOURCE_USERNAME=cloudbuilder
SPRING_DATASOURCE_PASSWORD=<same-as-db-password>

# ─── Frontend ──────────────────────────────────────────────────────────
VITE_API_URL=https://yourdomain.com/api/v1
