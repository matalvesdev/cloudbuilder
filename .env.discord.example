# ═══════════════════════════════════════════════════════════
# Discord Webhooks — CloudBuilder
# Copie para .env.discord e preencha com suas URLs
# ═══════════════════════════════════════════════════════════

# ── Webhook Principal (fallback quando canal específico não existe) ──
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"

# ── Webhooks por Canal ──────────────────────────────────────────────
# Crie um webhook para cada canal no Discord
# Server Settings → Integrations → Webhooks → New Webhook

# Canal #bugs — Bugs reportados pelos testers
DISCORD_BUG_WEBHOOK_URL="https://discord.com/api/webhooks/BUGS_WEBHOOK_ID/BUGS_WEBHOOK_TOKEN"

# Canal #feedback-rápido — Notas 1-5 estrelas
DISCORD_FEEDBACK_WEBHOOK_URL="https://discord.com/api/webhooks/FEEDBACK_WEBHOOK_ID/FEEDBACK_WEBHOOK_TOKEN"

# Canal #sugestões — Ideias e melhorias
DISCORD_SUGGESTIONS_WEBHOOK_URL="https://discord.com/api/webhooks/SUGGESTIONS_WEBHOOK_ID/SUGGESTIONS_WEBHOOK_TOKEN"

# Canal #dúvidas — Perguntas sobre uso
DISCORD_QUESTIONS_WEBHOOK_URL="https://discord.com/api/webhooks/QUESTIONS_WEBHOOK_ID/QUESTIONS_WEBHOOK_TOKEN"

# Canal #suporte-técnico — Problemas técnicos
DISCORD_SUPPORT_WEBHOOK_URL="https://discord.com/api/webhooks/SUPPORT_WEBHOOK_ID/SUPPORT_WEBHOOK_TOKEN"

# ── Slack (alternativa ao Discord) ──────────────────────────────────
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."
# SLACK_BUG_WEBHOOK_URL="https://hooks.slack.com/services/..."
# SLACK_FEEDBACK_WEBHOOK_URL="https://hooks.slack.com/services/..."
