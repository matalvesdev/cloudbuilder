# ═══════════════════════════════════════════════════════════════════════════
# CloudBuilder Backend — Render Deploy
# ═══════════════════════════════════════════════════════════════════════════

# Stage 1: Build
FROM maven:3.9-eclipse-temurin-21-alpine AS build
WORKDIR /app
COPY pom.xml ./
COPY .mvn .mvn
RUN --mount=type=cache,target=/root/.m2 \
    mvn dependency:go-offline -q
COPY src src
RUN --mount=type=cache,target=/root/.m2 \
    mvn package -DskipTests -Dmaven.test.skip=true -q

# Stage 2: Extract layers
FROM eclipse-temurin:21-jre-alpine AS layers
WORKDIR /app
COPY --from=build /app/target/*.jar app.jar
RUN java -Djarmode=layertools -jar app.jar extract

# Stage 3: Runtime
FROM eclipse-temurin:21-jre-alpine
RUN addgroup -S cloudbuilder && adduser -S cloudbuilder -G cloudbuilder -u 1000 && apk add --no-cache curl
WORKDIR /app
RUN mkdir -p /app/logs && chown cloudbuilder:cloudbuilder /app/logs
COPY --from=layers /app/dependencies/ ./
COPY --from=layers /app/spring-boot-loader/ ./
COPY --from=layers /app/snapshot-dependencies/ ./
COPY --from=layers /app/application/ ./
USER cloudbuilder
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8080/actuator/health || exit 1
ENTRYPOINT ["java", "org.springframework.boot.loader.launch.JarLauncher"]
