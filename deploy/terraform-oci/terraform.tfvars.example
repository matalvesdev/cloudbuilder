# ═══════════════════════════════════════════════════════════════════════════
# CloudBuilder — Terraform Variables (Example)
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to terraform.tfvars and fill in your values.
#
# How to find your Compartment OCID:
#   1. Login to https://cloud.oracle.com
#   2. Click your profile icon (top right) → Tenancy: <name>
#   3. Copy the "OCID" value
#   4. Or: Identity → Compartments → click your compartment → OCID
# ═══════════════════════════════════════════════════════════════════════════

# REQUIRED: Your tenancy/compartment OCID
compartment_ocid = "ocid1.compartment.oc1..aaaaaaaaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Region (default: sa-saopaulo-1 for Brazil)
# Available regions: https://docs.oracle.com/en-us/iaas/Content/General/Concepts/regions.htm
region = "sa-saopaulo-1"

# Instance shape (default: VM.Standard.A1.Flex for ARM free tier)
# instance_shape = "VM.Standard.A1.Flex"

# Resources (free tier limits: 4 OCPU, 24GB RAM)
# ocpus = 4
# memory_in_gbs = 24
# boot_volume_size_gbs = 100

# SSH public key (optional — if empty, Terraform generates a key pair)
# ssh_public_key = "ssh-ed25519 AAAA... your-key"
